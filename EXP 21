import spacy

nlp = spacy.load("en_core_web_sm")

text = "The intelligent student solved the difficult problem."

doc = nlp(text)

for chunk in doc.noun_chunks:
    print("Noun Phrase:", chunk.text)

    if "student" in chunk.text:
        print("Meaning: A person who studies")

    elif "problem" in chunk.text:
        print("Meaning: A matter requiring a solution")

    print()
